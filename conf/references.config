// Genomes under /bioinfo/ref are built by hts-scripts/utils/reference_builder.nf, which lays out
// <name>/bwameth/<name>.fa and, when given --contig_groups, <name>/gc_groups/. Setting
// gc_groups_dir turns on per-organism GC bias curves for that genome; omitting it yields the
// whole-reference curve alone.
params {
    genomes = [
        'T2T_chm13v2.0+bs_controls': [
            bwa_index: "/bioinfo/ref/T2T_chm13v2.0+bs_controls/bwameth/T2T_chm13v2.0+bs_controls.fa",
            genome_fa: "/bioinfo/ref/T2T_chm13v2.0+bs_controls/bwameth/T2T_chm13v2.0+bs_controls.fa",
            genome_fai: "/bioinfo/ref/T2T_chm13v2.0+bs_controls/bwameth/T2T_chm13v2.0+bs_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/T2T_chm13v2.0+bs_controls/gc_groups",
            target_bed: "/bioinfo/ref/t2t_chm13_v2+meth_controls+m13+phix/folded_windows/T2T_chm13v2.0+meth_controls_hairpins.s18w200nogt.bed"
        ],
        'grcm39+meth_controls': [
            bwa_index: "/bioinfo/ref/grcm39+meth_controls/bwameth/grcm39+meth_controls.fa",
            genome_fa: "/bioinfo/ref/grcm39+meth_controls/bwameth/grcm39+meth_controls.fa",
            genome_fai: "/bioinfo/ref/grcm39+meth_controls/bwameth/grcm39+meth_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/grcm39+meth_controls/gc_groups",
        ],
        't2t_2.0_eschColi_K12_bs_controls': [
            bwa_index: "/bioinfo/ref/t2t_2.0_eschColi_K12_bs_controls/bwameth/t2t_2.0_eschColi_K12_bs_controls.fa",
            genome_fa: "/bioinfo/ref/t2t_2.0_eschColi_K12_bs_controls/bwameth/t2t_2.0_eschColi_K12_bs_controls.fa",
            genome_fai: "/bioinfo/ref/t2t_2.0_eschColi_K12_bs_controls/bwameth/t2t_2.0_eschColi_K12_bs_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/t2t_2.0_eschColi_K12_bs_controls/gc_groups",
        ],
        'grch38_core+bs_controls': [
            bwa_index: "/bioinfo/ref/grch38_core+bs_controls/bwameth/grch38_core+bs_controls.fa",
            genome_fa: "/bioinfo/ref/grch38_core+bs_controls/bwameth/grch38_core+bs_controls.fa",
            genome_fai: "/bioinfo/ref/grch38_core+bs_controls/bwameth/grch38_core+bs_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/grch38_core+bs_controls/gc_groups",
        ],
        'arabidopsis_thaliana_TAIR12_bs_controls': [
            bwa_index: "/bioinfo/ref/arabidopsis_thaliana_TAIR12_bs_controls/bwameth/arabidopsis_thaliana_TAIR12_bs_controls.fa",
            genome_fa: "/bioinfo/ref/arabidopsis_thaliana_TAIR12_bs_controls/bwameth/arabidopsis_thaliana_TAIR12_bs_controls.fa",
            genome_fai: "/bioinfo/ref/arabidopsis_thaliana_TAIR12_bs_controls/bwameth/arabidopsis_thaliana_TAIR12_bs_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/arabidopsis_thaliana_TAIR12_bs_controls/gc_groups",
        ],
        't2t_chm13_v2+meth_controls+m13+phix': [
            bwa_index: "/bioinfo/ref/t2t_chm13_v2+meth_controls+m13+phix/bwameth/t2t_chm13_v2+meth_controls+m13+phix.fa",
            genome_fa: "/bioinfo/ref/t2t_chm13_v2+meth_controls+m13+phix/bwameth/t2t_chm13_v2+meth_controls+m13+phix.fa",
            genome_fai: "/bioinfo/ref/t2t_chm13_v2+meth_controls+m13+phix/bwameth/t2t_chm13_v2+meth_controls+m13+phix.fa.fai",
            gc_groups_dir: "/bioinfo/ref/t2t_chm13_v2+meth_controls+m13+phix/gc_groups",
        ],
        'rCheMyd1.pri.v2_bs_controls': [
            bwa_index: "/bioinfo/ref/rCheMyd1.pri.v2_bs_controls/bwameth/rCheMyd1.pri.v2_bs_controls.fa",
            genome_fa: "/bioinfo/ref/rCheMyd1.pri.v2_bs_controls/bwameth/rCheMyd1.pri.v2_bs_controls.fa",
            genome_fai: "/bioinfo/ref/rCheMyd1.pri.v2_bs_controls/bwameth/rCheMyd1.pri.v2_bs_controls.fa.fai",
            gc_groups_dir: "/bioinfo/ref/rCheMyd1.pri.v2_bs_controls/gc_groups",
        ],
        'test': [
            bwa_index: "${projectDir}/tests/fixtures/reference_files/reference.fa",
            genome_fa: "${projectDir}/tests/fixtures/reference_files/reference.fa",
            genome_fai: "${projectDir}/tests/fixtures/reference_files/reference.fa.fai",
            target_bed: "${projectDir}/tests/fixtures/target_bed/emseq_test_regions.bed"
        ]
    ]
}
